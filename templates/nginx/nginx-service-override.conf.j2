# Managed by ansible-role-freesocks.
#
# The package's unit runs `nginx -c ${CONFFILE}`; this points it at the
# role's own file (the package's /etc/nginx/nginx.conf stays untouched, so
# upgrades never stop at a conffile question). /etc/default/nginx only
# carries a commented CONFFILE, so nothing there overrides this.
#
# The master starts as root (it binds the ports, reads the keys, then drops
# its workers to the nginx user); the rest confines it.
[Service]
Environment="CONFFILE={{ remnawave_nginx_conf }}"
LimitNOFILE={{ nginx_worker_rlimit_nofile }}

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE
ProtectSystem=strict
ReadWritePaths=/var/log/nginx /var/cache/nginx {{ remnawave_nginx_acme_state_dir | dirname }} /run
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
