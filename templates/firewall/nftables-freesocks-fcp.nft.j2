# Managed by ansible-role-freesocks: the ports FCP lists for this node, TCP in
# freesocks_fcp and UDP in freesocks_fcp_udp.
# Include this file inside the table that holds your input chain, and let both
# sets in from that chain:
#   include "{{ fcp_firewall_nftables_file }}"
#   tcp dport @freesocks_fcp accept
#   udp dport @freesocks_fcp_udp accept
# The role rewrites these sets and nothing else.
{% for _name, _proto in [['freesocks_fcp', 'tcp'], ['freesocks_fcp_udp', 'udp']] %}
{% set _ports = _fw_desired | fcp_fw_ports(_proto) %}
set {{ _name }} {
	type inet_service
{% if _ports | length > 0 %}
	elements = { {{ _ports | join(', ') }} }
{% endif %}
}
{% endfor %}
